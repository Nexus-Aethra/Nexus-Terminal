{
  "name": "@nexus-aethra/dshell-files",
  "version": "0.1.18-alpha.1",
  "description": "dshell file navigator: replaces dsh's right-sidebar Files tab type with a movable browser 鈥?a `..` row, clickable path segments, back/forward history over the session's own execution world (a device's whole tree for a device session).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexus-Aethra/Nexus-Terminal.git",
    "directory": "packages/dshell/files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-dockkit",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx",
    "prepack": "corepack pnpm run build",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client/address.js",
    "lib/client/body.js",
    "lib/client/client.js",
    "lib/client/definition.js",
    "lib/client/drag.js",
    "lib/client/face.js",
    "lib/client/index.js",
    "lib/client/locales.js",
    "lib/client/store.js",
    "lib/client/styles.js",
    "lib/client/title.js",
    "lib/client/transfer-body.js",
    "lib/client/transfer-client.js",
    "lib/client/transfer-definition.js",
    "lib/client/transfer-drag.js",
    "lib/client/transfer-face.js",
    "lib/client/transfer-glyph.js",
    "lib/client/transfer-styles.js",
    "lib/client/transfer-title.js",
    "lib/protocol.js",
    "lib/readings.js",
    "lib/route.js",
    "lib/shell-completion.js",
    "lib/shell-quote.js",
    "lib/transfer-protocol.js",
    "lib/transfer-route.js",
    "lib/transfer.js",
    "lib/world-shell.js",
    "lib/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nexus-aethra/dshell-std": "workspace:^",
    "@nexus-aethra/dshell-terminal-bridge": "workspace:^",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
