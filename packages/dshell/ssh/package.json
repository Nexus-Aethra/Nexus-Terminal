{
  "name": "@nexus-aethra/dshell-ssh",
  "version": "0.1.18-alpha.2",
  "description": "dshell SSH devices: a durable device/key registry, per-session device binding, and remote execution for a bound session's command tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexus-Aethra/Nexus-Terminal.git",
    "directory": "packages/dshell/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./helper": {
      "types": "./lib/types/helper-entry.d.ts",
      "default": "./lib/helper.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false && tsdown --config-loader tsx && node scripts/drop-intermediates.mjs",
    "prepack": "corepack pnpm run build",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:client": "tsdown --config-loader tsx"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/channel-process.js",
    "lib/client.js",
    "lib/client/admin.js",
    "lib/client/card-styles.js",
    "lib/client/card.js",
    "lib/client/index.js",
    "lib/client/locales.js",
    "lib/client/nav-icon.js",
    "lib/client/service.js",
    "lib/client/session-bind.js",
    "lib/client/vault-card.js",
    "lib/connection.js",
    "lib/credentials.js",
    "lib/device-dialect.js",
    "lib/device-fs-provider.js",
    "lib/devices.js",
    "lib/forward/forwarder.js",
    "lib/forward/route.js",
    "lib/forward/tool.js",
    "lib/fs-routing.js",
    "lib/helper.js",
    "lib/helper/fs.js",
    "lib/helper/install.js",
    "lib/helper/processes.js",
    "lib/helper/protocol.js",
    "lib/helper/target.js",
    "lib/host-key.js",
    "lib/host-locales.js",
    "lib/literal-edit.js",
    "lib/local-keys.js",
    "lib/mount.js",
    "lib/paths.js",
    "lib/protocol.js",
    "lib/registry.js",
    "lib/remote-fs-helper.js",
    "lib/remote-fs-shell.js",
    "lib/remote-fs-transport.js",
    "lib/remote-fs.js",
    "lib/remote-process.js",
    "lib/route.js",
    "lib/router.js",
    "lib/shell-quote.js",
    "lib/spawn-routing.js",
    "lib/ssh-settings.js",
    "lib/transport/auth.js",
    "lib/transport/errors.js",
    "lib/transport/known-hosts.js",
    "lib/transport/transport.js",
    "lib/vault.js",
    "lib/types/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-ssh": "0.1.5-rc.2 || 0.1.6-alpha.2 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.3-0",
