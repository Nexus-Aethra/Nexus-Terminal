{
  "name": "@nexus-aethra/dshell-host-tools",
  "version": "0.1.3",
  "description": "Host capabilities belong to local sessions. Provides the browser-use provider (upstream's dsh-browser-use registry) and denies the desktop tools of upstream's computer-use provider in every session bound to an SSH device.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexus-Aethra/Nexus-Terminal.git",
    "directory": "packages/dshell/host-tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "build:host": "tsc -p tsconfig.json --emitDeclarationOnly false"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nexus-aethra/dshell-ssh": "workspace:^",
    "@playwright/mcp": "0.0.80"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-browser-use": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^24",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-browser-use": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2 || 0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "typescript": "^6.0.3"
  }
}
